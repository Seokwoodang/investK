# ─────────────────────────────────────────────────────────────
# 모든 키는 선택사항입니다. 없으면 해당 영역은 목(mock) 데이터로 자동 폴백합니다.
# .env.local 로 복사해서 채워 넣으세요 (서버 전용 키는 절대 클라이언트에 노출 금지).
# ─────────────────────────────────────────────────────────────

# 한국투자증권 KIS Open API (국내주식 시세) — https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전계좌: https://openapi.koreainvestment.com:9443  /  모의투자: https://openapivts.koreainvestment.com:29443
KIS_BASE=https://openapi.koreainvestment.com:9443

# 해외주식 (둘 중 하나) — Finnhub: https://finnhub.io  /  Twelve Data: https://twelvedata.com
FINNHUB_KEY=
TWELVEDATA_KEY=

# 뉴스 — 네이버 검색 API: https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Supabase (AI 분석 캐시 · 향후 관심종목 동기화) — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude (데일리/차트 AI 생성) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# 선택: 생성 모델 (기본 claude-sonnet-4-6, 최고 품질은 claude-opus-4-8)
ANTHROPIC_MODEL=claude-sonnet-4-6

# 로그인 — 아이디/비번은 Supabase `app_users` 테이블에 저장(여기엔 비번 안 넣음). 회원가입 없음.
# 세션 쿠키 서명키만 env로: 길고 랜덤하게 → openssl rand -hex 32
AUTH_SECRET=

# 인스타그램 자동 게시 — 60일 장기 토큰. 주 1회 크론이 갱신해 Supabase kv_store에 저장하므로
# 여기 값은 최초 부트스트랩용이다(갱신본이 있으면 그쪽이 우선).
INSTA_TOKEN=

# 스레드(Threads) 자동 게시 — 인스타와 별개 토큰. 발급 방법:
#  1) developers.facebook.com 앱에 Threads API 추가
#  2) 권한: threads_basic, threads_content_publish
#  3) 단기 토큰 → 장기 토큰(60일) 교환 후 아래에 넣기
# 미설정이면 게시·갱신 크론이 503으로 조용히 스킵한다(실패 알림 없음).
THREADS_TOKEN=
